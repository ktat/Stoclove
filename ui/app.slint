import { Button, LineEdit, ListView, ScrollView, TabWidget, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { RecipeCard } from "components/recipe_card.slint";
import { RecipeDetail } from "components/recipe_detail.slint";
import { StockView } from "components/stock_view.slint";
import { AddRecipeDialog } from "components/add_recipe_dialog.slint";
import { Theme } from "components/theme.slint";
import { RecipeModel, IngredientModel, SubstituteModel, AppView } from "components/types.slint";

export { RecipeModel, IngredientModel, SubstituteModel, AppView }

export component AppWindow inherits Window {
    title: "Stoclove";
    preferred-width: 420px;
    preferred-height: 800px;
    background: Theme.background;

    // ── Callbacks (Rust side implements) ─────────────────────────────────────
    callback search-changed(string);
    callback recipe-selected(string);
    callback back-pressed();
    callback add-from-url(string);
    callback add-from-text(string);
    callback delete-recipe(string);
    callback sync-pressed();
    callback navigate-stock();
    callback navigate-main();
    callback navigate-add();

    // ── State ─────────────────────────────────────────────────────────────────
    in-out property <[RecipeModel]> recipes: [];
    in-out property <[IngredientModel]> detail-ingredients: [];
    in-out property <[SubstituteModel]> detail-substitutes: [];
    in-out property <RecipeModel> selected-recipe: {
        id: "",
        title: "",
        source-url: "",
        instructions: "",
        substitutes-json: "",
        ingredient-names: "",
        ingredient-count: 0,
    };
    in-out property <[IngredientModel]> stock-ingredients: [];
    in-out property <AppView> current-view: AppView.Main;
    in-out property <string> status-message: "";
    in-out property <bool> is-syncing: false;

    // ── Layout ────────────────────────────────────────────────────────────────
    VerticalBox {
        padding: 0px;
        spacing: 0px;

        // Top Bar
        Rectangle {
            height: 56px;
            background: Theme.primary;
            drop-shadow-blur: 4px;
            drop-shadow-color: Theme.shadow;

            HorizontalBox {
                padding-left: 8px;
                padding-right: 8px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 8px;
                alignment: center;

                if current-view != AppView.Main: Button {
                    text: "← Back";
                    clicked => { root.back-pressed(); }
                }

                Text {
                    text: current-view == AppView.Main ? "Stoclove"
                        : current-view == AppView.Detail ? selected-recipe.title
                        : current-view == AppView.Stock ? "My Pantry"
                        : "Add Recipe";
                    font-size: 20px;
                    font-weight: 700;
                    color: Theme.on-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                if current-view == AppView.Main: Button {
                    text: is-syncing ? "Syncing..." : "Sync";
                    enabled: !is-syncing;
                    clicked => { root.sync-pressed(); }
                }
            }
        }

        // Status bar
        if status-message != "": Rectangle {
            height: 32px;
            background: Theme.info-bg;
            Text {
                text: status-message;
                color: Theme.info-text;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // ── Main View ─────────────────────────────────────────────────────────
        if current-view == AppView.Main: VerticalBox {
            padding: 12px;
            spacing: 8px;

            // Search bar
            LineEdit {
                placeholder-text: "Search by ingredient or title...";
                edited(text) => { root.search-changed(text); }
            }

            // Nav buttons
            HorizontalBox {
                spacing: 8px;
                Button {
                    text: "Pantry";
                    horizontal-stretch: 1;
                    clicked => { root.navigate-stock(); }
                }
                Button {
                    text: "+ Add Recipe";
                    horizontal-stretch: 1;
                    clicked => { root.navigate-add(); }
                }
            }

            // Empty state
            if recipes.length == 0: Rectangle {
                height: 160px;
                Text {
                    text: "No recipes yet.\nAdd one via URL or paste text!";
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    color: Theme.text-secondary;
                    font-size: 14px;
                }
            }

            // Recipe list
            ScrollView {
                vertical-stretch: 1;
                VerticalBox {
                    padding: 0px;
                    spacing: 8px;
                    for recipe in recipes: RecipeCard {
                        recipe: recipe;
                        clicked => { root.recipe-selected(recipe.id); }
                        delete-clicked => { root.delete-recipe(recipe.id); }
                    }
                }
            }
        }

        // ── Detail View ───────────────────────────────────────────────────────
        if current-view == AppView.Detail: RecipeDetail {
            recipe: selected-recipe;
            ingredients: detail-ingredients;
            substitutes: detail-substitutes;
            vertical-stretch: 1;
        }

        // ── Stock View ────────────────────────────────────────────────────────
        if current-view == AppView.Stock: StockView {
            ingredients: stock-ingredients;
            vertical-stretch: 1;
            ingredient-clicked(name) => {
                root.search-changed(name);
                root.navigate-main();
            }
        }

        // ── Add Recipe View ───────────────────────────────────────────────────
        if current-view == AppView.AddRecipe: AddRecipeDialog {
            vertical-stretch: 1;
            add-url(url) => { root.add-from-url(url); }
            add-text(text) => { root.add-from-text(text); }
        }
    }
}
