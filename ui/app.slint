import { Button, LineEdit, ScrollView, TabWidget, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { RecipeCard } from "components/recipe_card.slint";
import { RecipeDetail } from "components/recipe_detail.slint";
import { StockView } from "components/stock_view.slint";
import { AddRecipeDialog } from "components/add_recipe_dialog.slint";
import { ModelSetupView, DownloadProgressView, LoadingModelView } from "components/model_setup.slint";
import { Theme } from "components/theme.slint";
import { RecipeModel, IngredientModel, SubstituteModel, ModelOptionModel, AppView } from "components/types.slint";

export { RecipeModel, IngredientModel, SubstituteModel, ModelOptionModel, AppView }

export component AppWindow inherits Window {
    title: "Stoclove";
    preferred-width: 420px;
    preferred-height: 800px;
    background: Theme.background;

    // ── Callbacks ─────────────────────────────────────────────────────────────
    callback search-changed(string);
    callback recipe-selected(string);
    callback back-pressed();
    callback add-from-url(string);
    callback add-from-text(string);
    callback delete-recipe(string);
    callback sync-pressed();
    callback navigate-stock();
    callback navigate-main();
    callback navigate-add();

    // モデルセットアップ
    callback download-model(string);   // model-id
    callback retry-ollama();

    // ── State ─────────────────────────────────────────────────────────────────
    in-out property <[RecipeModel]> recipes: [];
    in-out property <[IngredientModel]> detail-ingredients: [];
    in-out property <[SubstituteModel]> detail-substitutes: [];
    in-out property <RecipeModel> selected-recipe: {
        id: "", title: "", source-url: "", instructions: "",
        substitutes-json: "", ingredient-names: "", ingredient-count: 0,
    };
    in-out property <[IngredientModel]> stock-ingredients: [];
    in-out property <AppView> current-view: AppView.Setup;
    in-out property <string> status-message: "";
    in-out property <bool> is-syncing: false;

    // モデルセットアップ
    in-out property <[ModelOptionModel]> available-models: [];
    in-out property <bool> ollama-running: false;
    in-out property <string> download-model-name: "";
    in-out property <float> download-progress: 0.0;
    in-out property <string> download-downloaded-text: "0 MB";
    in-out property <string> download-total-text: "---";
    in-out property <string> loading-model-name: "";

    // ── Layout ────────────────────────────────────────────────────────────────
    VerticalBox {
        padding: 0px;
        spacing: 0px;

        // ヘッダーバー (Setup/Downloading/Loading 時は非表示)
        if current-view != AppView.Setup
            && current-view != AppView.Downloading
            && current-view != AppView.Loading: Rectangle {
            height: 56px;
            background: Theme.primary;
            drop-shadow-blur: 4px;
            drop-shadow-color: Theme.shadow;

            HorizontalBox {
                padding-left: 8px;
                padding-right: 8px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 8px;
                alignment: center;

                if current-view != AppView.Main: Button {
                    text: "← 戻る";
                    clicked => { root.back-pressed(); }
                }

                Text {
                    text: current-view == AppView.Main ? "Stoclove"
                        : current-view == AppView.Detail ? selected-recipe.title
                        : current-view == AppView.Stock ? "パントリー"
                        : "レシピを追加";
                    font-size: 20px;
                    font-weight: 700;
                    color: Theme.on-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                if current-view == AppView.Main: Button {
                    text: is-syncing ? "同期中..." : "同期";
                    enabled: !is-syncing;
                    clicked => { root.sync-pressed(); }
                }
            }
        }

        // ステータスバー
        if status-message != "": Rectangle {
            height: 32px;
            background: Theme.info-bg;
            Text {
                text: status-message;
                color: Theme.info-text;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // ── Setup: モデル選択 ─────────────────────────────────────────────────
        if current-view == AppView.Setup: ModelSetupView {
            models: available-models;
            ollama-running: ollama-running;
            vertical-stretch: 1;
            download-pressed(id) => { root.download-model(id); }
            retry-ollama => { root.retry-ollama(); }
        }

        // ── Downloading: 進捗表示 ─────────────────────────────────────────────
        if current-view == AppView.Downloading: DownloadProgressView {
            model-name: download-model-name;
            progress: download-progress;
            downloaded-text: download-downloaded-text;
            total-text: download-total-text;
            vertical-stretch: 1;
        }

        // ── Loading: モデル読み込み中 ─────────────────────────────────────────
        if current-view == AppView.Loading: LoadingModelView {
            model-name: loading-model-name;
            vertical-stretch: 1;
        }

        // ── Main: レシピ一覧 ──────────────────────────────────────────────────
        if current-view == AppView.Main: VerticalBox {
            padding: 12px;
            spacing: 8px;

            LineEdit {
                placeholder-text: "食材名またはレシピ名で検索...";
                edited(text) => { root.search-changed(text); }
            }

            HorizontalBox {
                spacing: 8px;
                Button {
                    text: "パントリー";
                    horizontal-stretch: 1;
                    clicked => { root.navigate-stock(); }
                }
                Button {
                    text: "+ レシピ追加";
                    horizontal-stretch: 1;
                    clicked => { root.navigate-add(); }
                }
            }

            if recipes.length == 0: Rectangle {
                height: 160px;
                Text {
                    text: "レシピがありません\nURLを貼るかテキストを貼り付けて追加しましょう";
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    color: Theme.text-secondary;
                    font-size: 14px;
                    wrap: word-wrap;
                }
            }

            ScrollView {
                vertical-stretch: 1;
                VerticalBox {
                    padding: 0px;
                    spacing: 8px;
                    for recipe in recipes: RecipeCard {
                        recipe: recipe;
                        clicked => { root.recipe-selected(recipe.id); }
                        delete-clicked => { root.delete-recipe(recipe.id); }
                    }
                }
            }
        }

        // ── Detail: レシピ詳細 ────────────────────────────────────────────────
        if current-view == AppView.Detail: RecipeDetail {
            recipe: selected-recipe;
            ingredients: detail-ingredients;
            substitutes: detail-substitutes;
            vertical-stretch: 1;
        }

        // ── Stock: パントリー ─────────────────────────────────────────────────
        if current-view == AppView.Stock: StockView {
            ingredients: stock-ingredients;
            vertical-stretch: 1;
            ingredient-clicked(name) => {
                root.search-changed(name);
                root.navigate-main();
            }
        }

        // ── AddRecipe: レシピ追加 ─────────────────────────────────────────────
        if current-view == AppView.AddRecipe: AddRecipeDialog {
            vertical-stretch: 1;
            add-url(url) => { root.add-from-url(url); }
            add-text(text) => { root.add-from-text(text); }
        }
    }
}
