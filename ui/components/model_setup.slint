import { Button, ScrollView, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { ModelOptionModel } from "types.slint";

// モデル選択カード (1 モデル分)
component ModelCard inherits Rectangle {
    in property <ModelOptionModel> model-opt;
    in property <bool> selected;
    callback clicked();

    min-height: 110px;
    border-radius: Theme.card-radius;
    border-width: selected ? 2px : 1px;
    border-color: selected ? Theme.primary : Theme.divider;
    background: selected ? #fff5f0 : Theme.surface;
    animate background { duration: 120ms; }
    animate border-color { duration: 120ms; }

    touch := TouchArea { clicked => { root.clicked(); } }

    VerticalBox {
        padding: 14px;
        spacing: 6px;

        HorizontalBox {
            spacing: 8px;
            alignment: start;

            // 選択インジケーター
            Rectangle {
                width: 18px;
                height: 18px;
                border-radius: 9px;
                border-width: 2px;
                border-color: selected ? Theme.primary : Theme.text-hint;
                background: transparent;

                if selected: Rectangle {
                    width: 10px;
                    height: 10px;
                    border-radius: 5px;
                    background: Theme.primary;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }

            Text {
                text: model-opt.name;
                font-size: 15px;
                font-weight: 700;
                color: Theme.text-primary;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            // サイズバッジ
            Rectangle {
                height: 22px;
                width: 72px;
                border-radius: 4px;
                background: Theme.tag-bg;
                Text {
                    text: model-opt.size-text;
                    font-size: 11px;
                    color: Theme.tag-text;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        Text {
            text: model-opt.description;
            font-size: 12px;
            color: Theme.text-secondary;
            wrap: word-wrap;
        }

        HorizontalBox {
            spacing: 12px;
            alignment: start;

            Text {
                text: "速度: " + model-opt.speed;
                font-size: 11px;
                color: Theme.text-hint;
            }
            Text {
                text: "精度: " + model-opt.accuracy;
                font-size: 11px;
                color: Theme.text-hint;
            }
        }
    }
}

// ── モデル選択ビュー ──────────────────────────────────────────────────────────
export component ModelSetupView inherits VerticalBox {
    in property <[ModelOptionModel]> models;
    in-out property <string> selected-id: "";
    in property <bool> ollama-running: true;
    callback download-pressed(string);
    callback retry-ollama();

    padding: 20px;
    spacing: 16px;

    Text {
        text: "Stoclove へようこそ";
        font-size: 22px;
        font-weight: 700;
        color: Theme.primary;
        horizontal-alignment: center;
    }

    // ── Ollama が起動していない場合 ───────────────────────────────────────────
    if !ollama-running: VerticalBox {
        spacing: 12px;

        Rectangle {
            background: #fff3cd;
            border-radius: 8px;
            min-height: 100px;
            VerticalBox {
                padding: 16px;
                spacing: 8px;
                Text {
                    text: "⚠ Ollama が起動していません";
                    font-size: 15px;
                    font-weight: 700;
                    color: #7d5a00;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Stoclove はオンデバイス AI に Ollama を使用します。\n以下の手順でインストール・起動してください。";
                    font-size: 12px;
                    color: #7d5a00;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
        }

        Rectangle {
            background: Theme.surface;
            border-radius: 8px;
            min-height: 120px;
            VerticalBox {
                padding: 16px;
                spacing: 6px;
                Text { text: "① ollama.com からインストール"; font-size: 13px; color: Theme.text-primary; }
                Text { text: "② ターミナルで: ollama serve"; font-size: 13px; color: Theme.text-secondary; font-family: "monospace"; }
                Text { text: "③ 下の「再試行」ボタンを押す"; font-size: 13px; color: Theme.text-primary; }
            }
        }

        Button {
            text: "再試行";
            primary: true;
            clicked => { root.retry-ollama(); }
        }
    }

    // ── Ollama 起動済み: モデル選択 ──────────────────────────────────────────
    if ollama-running: VerticalBox {
        spacing: 16px;
        vertical-stretch: 1;

        Text {
            text: "AI モデルを選択してください\nレシピの解析・食材抽出に使用します";
            font-size: 14px;
            color: Theme.text-secondary;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        ScrollView {
            vertical-stretch: 1;
            VerticalBox {
                padding: 0px;
                spacing: 10px;
                for m in models: ModelCard {
                    model-opt: m;
                    selected: root.selected-id == m.id;
                    clicked => { root.selected-id = m.id; }
                }
            }
        }
    }

    Button {
        text: selected-id == "" ? "モデルを選んでください" : "ダウンロードして開始";
        primary: true;
        enabled: selected-id != "";
        clicked => { root.download-pressed(selected-id); }
    }
}

// ── ダウンロード進捗ビュー ────────────────────────────────────────────────────
export component DownloadProgressView inherits VerticalBox {
    in property <string> model-name;
    in property <float> progress;       // 0.0 〜 1.0
    in property <string> downloaded-text;
    in property <string> total-text;

    padding: 32px;
    spacing: 20px;
    alignment: center;

    Text {
        text: "モデルをダウンロード中...";
        font-size: 18px;
        font-weight: 700;
        color: Theme.text-primary;
        horizontal-alignment: center;
    }

    Text {
        text: model-name;
        font-size: 14px;
        color: Theme.text-secondary;
        horizontal-alignment: center;
    }

    // プログレスバー
    Rectangle {
        height: 12px;
        border-radius: 6px;
        background: Theme.surface-variant;
        clip: true;

        Rectangle {
            width: parent.width * root.progress;
            height: parent.height;
            border-radius: 6px;
            background: Theme.primary;
            animate width { duration: 300ms; easing: ease-out; }
        }
    }

    HorizontalBox {
        alignment: space-between;
        Text {
            text: downloaded-text;
            font-size: 13px;
            color: Theme.text-secondary;
        }
        Text {
            text: Math.round(root.progress * 100) + "%";
            font-size: 13px;
            font-weight: 600;
            color: Theme.primary;
        }
        Text {
            text: total-text;
            font-size: 13px;
            color: Theme.text-secondary;
        }
    }

    Text {
        text: "HuggingFace からダウンロード中\nアプリを閉じないでください";
        font-size: 12px;
        color: Theme.text-hint;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
}

// ── モデル読み込み中ビュー ────────────────────────────────────────────────────
export component LoadingModelView inherits VerticalBox {
    in property <string> model-name;

    padding: 32px;
    spacing: 16px;
    alignment: center;

    Text {
        text: "モデルを読み込み中...";
        font-size: 18px;
        font-weight: 700;
        color: Theme.text-primary;
        horizontal-alignment: center;
    }

    Text {
        text: model-name;
        font-size: 13px;
        color: Theme.text-secondary;
        horizontal-alignment: center;
    }

    Text {
        text: "初回は数秒かかります";
        font-size: 12px;
        color: Theme.text-hint;
        horizontal-alignment: center;
    }
}
