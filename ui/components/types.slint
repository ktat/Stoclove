export struct RecipeModel {
    id: string,
    title: string,
    source-url: string,
    instructions: string,
    substitutes-json: string,
    ingredient-names: string,
    ingredient-count: int,
}

export struct IngredientModel {
    recipe-id: string,
    name: string,
    amount: string,
    unit: string,
}

export struct SubstituteModel {
    ingredient: string,
    alternatives: string,
    note: string,
}

export struct ModelOptionModel {
    id: string,
    name: string,
    description: string,
    size-text: string,
    speed: string,
    accuracy: string,
    recommended: bool,
}

export enum AppView {
    Setup,        // 初回起動: モデル選択
    Downloading,  // ダウンロード中
    Loading,      // モデル読み込み中
    Main,
    Detail,
    Stock,
    AddRecipe,
}
